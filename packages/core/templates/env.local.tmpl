{{#IF_GUARDIAN}}
# ─── Guardian (Auto-Merge Daemon) ───────────────────────────
# Controls the autonomous PR lifecycle manager.
# Primary switches — set GUARDIAN_ENABLED=true when you're ready for auto-merge:
GUARDIAN_ENABLED=false
GUARDIAN_DRY_RUN=true
GUARDIAN_CI_AUTOFIX=false
#
# Advanced tuning (defaults shown; uncomment to override). Read by
# packages/daemon/src/lib/factories.ts — keep this list in sync with it.
#
# Merge behavior:
# GUARDIAN_COMBINED_MERGE=true               # batch several ready PRs into one merge; =false merges one-at-a-time
# GUARDIAN_OPTIMISTIC_MERGE=true             # merge when checks are green-enough vs. waiting on every pending check; =false to disable
# GUARDIAN_OPTIMISTIC_MERGE_MAX_FILES=10     # max changed files for a PR to be optimistic-merge eligible
# GUARDIAN_REQUIRE_REVIEW_FOR_FEATURES=false # require a human review before merging feat: PRs
#
# Rebase behavior:
# GUARDIAN_REBASE_COOLDOWN_MS=30000          # min ms between rebase attempts on the same PR
# GUARDIAN_UPDATE_BRANCH=false               # use GitHub's update-branch API instead of a local rebase
#
# Conflict / CI limits:
# MAX_CONFLICT_FILES=5                        # max conflicted files Guardian will try to auto-resolve
# GUARDIAN_REGENERABLE_CONFLICT_PATHS=apps/traqr-site/src/data/field-notes.json  # comma-list of generated paths safe to regenerate on conflict
# MAX_CI_FIX_ATTEMPTS=2                       # max CI auto-fix attempts per PR (needs GUARDIAN_CI_AUTOFIX=true)
# MAX_CASCADE_RESOLUTIONS=10                  # max PRs resolved in one post-merge cascade
#
# Observability:
# GUARDIAN_METRICS_ENABLED=true              # emit Guardian metrics to KV; =false to disable
#
# Dormant arms — set nowhere in committed config; documented so the knobs are discoverable.
# Wiring these needs the Mac-Mini .env.local (TD-972 finding 3 — wire-vs-park still open):
# GUARDIAN_FEEDBACK_AUTOADDRESS=false        # auto-address PR review feedback (path early-returns 'feedback-skipped' until true)
# GUARDIAN_GRUNT_ENABLED=false               # dispatch Guardian-detected fixes to the grunt slot
# GRUNT_WORKTREE_PATH=<worktrees>/grunt      # grunt worktree path; only used when GUARDIAN_GRUNT_ENABLED=true
{{/IF_GUARDIAN}}

